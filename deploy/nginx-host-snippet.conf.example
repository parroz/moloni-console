# Example for YOUR existing nginx (do not replace the whole server).
# 1) Pick a subdomain, e.g. moloni.example.com, DNS A/AAAA → this server.
# 2) Point upstream to the Docker-published loopback port (default 9080).
# 3) docker compose uses: ports: "127.0.0.1:9080:80"
#
# Include this as a new file under /etc/nginx/conf.d/ or paste inside a server { }.

upstream moloni_console_web {
    server 127.0.0.1:9080;
}

server {
    listen 443 ssl http2;
    server_name moloni.example.com;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://moloni_console_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Agent SSE stream — separate location with no buffering and a long timeout.
    # The agent can sit quiet for ~30s while Claude processes the PDF, then run
    # for several minutes through tool calls. 120s timeout would kill the stream.
    location /api/agent/ {
        proxy_pass http://moloni_console_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

# Optional HTTP → HTTPS
# server {
#     listen 80;
#     server_name moloni.example.com;
#     return 301 https://$host$request_uri;
# }
