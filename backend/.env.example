# Moloni API — nomes alinhados ao painel Moloni (https://www.moloni.pt/dev/autenticacao/)
# O pedido /grant usa na query client_id e client_secret (OAuth); no painel aparecem como DEVELOPER_ID e CLIENT_KEY.
MOLONI_DEVELOPER_ID=
MOLONI_CLIENT_KEY=

# Compatível com nomes antigos (qualquer um dos pares funciona):
# MOLONI_CLIENT_ID=        (= DEVELOPER_ID)
# MOLONI_CLIENT_SECRET=    (= CLIENT_KEY)

MOLONI_USERNAME=
# Palavra-passe em texto claro (ex.: 'MinhaLoja&2026') — não use URL-encoding no .env (o cliente HTTP volta a codificar).
# Se tiver caracteres especiais, use aspas: MOLONI_PASSWORD='...&...'
MOLONI_PASSWORD=
MOLONI_COMPANY_ID=0

# IVA % para converter PVP→preço sem IVA quando o artigo não devolve IVA normalizado ou devolve valor inválido (>23%).
# MOLONI_DEFAULT_RETAIL_VAT_PERCENT=23

# App login (single shared password for staff)
CONSOLE_PASSWORD=changeme

# Session signing (use: openssl rand -hex 32)
SESSION_SECRET=replace-with-random-32-bytes-hex

# Browser origins allowed to send cookies (comma-separated). Em produção: https://moloni.o-teu-dominio.pt
CORS_ORIGINS=http://localhost:5173

# Cookie só em HTTPS (1) quando o site é servido em https atrás do nginx
SESSION_COOKIE_SECURE=0

# ── Agente (extracção PDF → fatura fornecedor) ──
# Chave da API Anthropic (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Modelo (default claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5
# Tecto de tokens de saída por extracção. Uma fatura com ~100 variantes
# expandidas gera ~25k tokens; o default 32000 cobre faturas grandes com
# margem. Subir até 64000 (limite de Sonnet 4.5) se necessário.
ANTHROPIC_MAX_TOKENS=32000
